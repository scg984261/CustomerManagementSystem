<Window x:Class="CustomerManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerManagementSystem"
        xmlns:userControls="clr-namespace:CustomerManagementSystem.View.UserControls"
        mc:Ignorable="d"
        Title="CMS" Height="900" Width="1500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="20"></RowDefinition>
        </Grid.RowDefinitions>

        <userControls:MenuBar />
        <userControls:DataGrid Grid.Row="1" />
        <userControls:FooterBar Grid.Row="2" />
    </Grid>
</Window>
